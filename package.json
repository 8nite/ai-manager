{
  "name": "ai-manager",
  "version": "0.2.2",
  "description": "Local multi-harness AI session manager (opencode, droid, deepseek-harness, agy) with a futuristic web UI and optional tunnel to ai-manager.nexvision.cc",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node src/server/index.js",
    "dev": "AI_MGR_DEV=1 node src/server/index.js",
    "tunnel": "node scripts/ai-tunnel.js",
    "tunnel:health": "node scripts/ai-tunnel-health.sh",
    "test": "node --test tests/*.test.js",
    "test:e2e": "bash scripts/e2e-web-defaults.sh"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  }
}
