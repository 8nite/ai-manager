+def _current_session_model() -> str:
+    """Default model = what the current opencode session uses.
+
+    Reads `~/.config/opencode/opencode.json` ("model"). Empty when absent or
+    not in provider/model form, so explicit HARNESS2_* env always wins.
+    """
+    try:
+        import json
+
+        raw = (Path.home() / ".config" / "opencode" / "opencode.json").read_text(
+            encoding="utf-8"
+        )
+        model = json.loads(raw).get("model", "")
+        return model if isinstance(model, str) and "/" in model else ""
+    except (OSError, ValueError, AttributeError):
+        return ""
+
+
+SOLVER_MODEL_OC = env("HARNESS2_SOLVER_MODEL", "") or _current_session_model()
 SOLVER_MODEL_CX = env("HARNESS2_CODEX_MODEL", SOLVER_MODEL_OC.split("/", 1)[-1])
 IMPROVER_MODEL = env("HARNESS2_IMPROVER_MODEL", SOLVER_MODEL_OC)
-JUDGE_MODEL = env("HARNESS2_JUDGE_MODEL", "")
+JUDGE_MODEL = env("HARNESS2_JUDGE_MODEL", "") or SOLVER_MODEL_OC
 
